DB_ENGINE=mysql
DB_NAME=aimsmile
DB_USER=aimsmile_user
DB_PASSWORD=replace-with-your-local-db-password
DB_HOST=127.0.0.1
DB_PORT=3306

# Email password recovery (keep credentials private)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=replace-with-your-gmail-app-password
DEFAULT_FROM_EMAIL=
SITE_URL=http://127.0.0.1:8000

# Google reCAPTCHA v2 checkbox
RECAPTCHA_ENABLED=false
RECAPTCHA_SITE_KEY=your-recaptcha-site-key
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key

# Twilio SMS (phone verification and OTP delivery)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMS_LOGIN_ENABLED=false

# Semaphore SMS appointment notices (Philippines)
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=AimSmile
APPOINTMENT_SMS_NOTIFICATIONS=true
APPOINTMENT_EMAIL_NOTIFICATIONS=true

# Google Calendar OAuth (create OAuth client in Google Cloud Console)
GOOGLE_CALENDAR_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CALENDAR_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_CALENDAR_REDIRECT_URI=http://127.0.0.1:8000/app/google-calendar/callback/
GOOGLE_CALENDAR_TOKEN_ENCRYPTION_KEY=

# Legacy AWS Rekognition settings (not used by local ID verification)
FACE_RECOGNITION_ENABLED=false
AWS_REGION=
AWS_REKOGNITION_COLLECTION_ID=aimsmile-patient-signups
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Local identity verification. Generate a private Fernet key; see README.md.
IDENTITY_TESSERACT_CMD=
IDENTITY_VERIFICATION_ENCRYPTION_KEY=replace-with-a-private-fernet-key
IDENTITY_MODEL_DIR=models/identity
IDENTITY_FACE_MATCH_THRESHOLD=0.363

# Xendit online invoice checkout. Use a test API key until production setup.
XENDIT_ENABLED=false
XENDIT_API_KEY=replace-with-test-api-key
XENDIT_CALLBACK_TOKEN=replace-with-test-callback-token

